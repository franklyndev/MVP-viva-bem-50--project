# Copie para .env e troque os valores. O .env nunca vai para o Git.
DB_USERNAME=vivabem
DB_PASSWORD=troque-esta-senha
DB_HOST_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/vivabem50
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
APP_TIMEZONE=America/Maceio
# Chave que assina os tokens de login. Use um texto aleatório com pelo menos 32 caracteres.
JWT_SECRET=troque-por-um-texto-aleatorio-com-32-caracteres-ou-mais
JWT_EXPIRATION=PT12H
# true cria a usuária de demonstração (maria@vivabem50.com) com uma rotina pronta.
DEMO_DATA_ENABLED=false
DEMO_USER_EMAIL=maria@vivabem50.com
DEMO_USER_PASSWORD=troque-esta-senha-de-demonstracao
